{
  "name": "nextgenagent",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "description": "Next-Gen Super Agent for Student",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @nextgen/web run dev",
    "dev:worker": "npm --workspace @nextgen/worker run dev",
    "hue:setup": "npm --workspace @nextgen/hue-companion run setup",
    "demo:hue": "npm --workspace @nextgen/web run build && npm --workspace @nextgen/hue-companion run start",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/ui-smoke.mjs",
    "test:developer": "node tests/developer-smoke.mjs",
    "deploy": "npm run build && npm --workspace @nextgen/worker run deploy",
    "process:interview-db": "python packages/rag/scripts/process_interview_pdf.py --all .local/candidate",
    "process:legacy-db": "python packages/rag/scripts/process_interview_pdf.py DB/old/Interview_DB1.pdf data/processed/interview-db1.chunks.json",
    "upload:vector-store": "node packages/rag/scripts/upload_vector_store.mjs .local/candidate",
    "diagnose": "node scripts/runtime.mjs check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
